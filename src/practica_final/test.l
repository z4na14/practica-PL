(setq resultado 0)
(setq contador 0)
(defun suma (a b )
(setf resultado (+ a b)))
(defun multiplica (a b )
(setf resultado (* a b)))
(defun es_par (v )
(if (= (mod v 2) 0)
(setf contador 1)
(setf contador 0))
)
(defun cuenta_hasta (n )
(setq cuenta_hasta_i 0)
(loop while (/= cuenta_hasta_i n) do
(setf contador (+ contador 1))
(setf cuenta_hasta_i (+ cuenta_hasta_i 1)))
)
(defun main ()
(suma 3 5 )
(princ resultado)
(multiplica 4 6 )
(princ resultado)
(es_par 10 )
(princ contador)
(es_par 7 )
(princ contador)
(cuenta_hasta 5 )
(princ contador))

(defun main ()
(setq main_a 8) (setq b 3) (setq c 5)
(setq main_mx (maximo main_a b ))
(setq main_mn (minimo b c ))
(setq main_av (abs_val (- 0 7) ))
(setq main_s (suma_rango 1 100 ))
(setq main_pw (potencia 2 10 ))
(setq main_cm (contar_multiplos 50 7 ))
(setq main_expr1 (- (* (+ main_a b) c) (/ main_mx main_mn)))
(setq main_expr2 (+ (mod main_s main_pw) (* main_av main_cm)))
(setq main_cond1 0)
(if (and (> main_mx 5) (< main_mn 5))
(setf main_cond1 1)
(setf main_cond1 0))
(setq main_cond2 0)
(if (or (> main_s 1000) (= main_pw 1024))
(setf main_cond2 1)
(setf main_cond2 0))
(setq main_cond3 0)
(if (/= (not main_cond1) 0)
(setf main_cond3 1)
(setf main_cond3 0))
(llenar_cuadrados 8 )
(setq main_max_v (max_array 8 ))
(setq main_pond (suma_ponderada 8 ))
(setq main_idx (buscar 8 25 ))
(setq main_cl (clasificar 2 ))
(setq main_acum 0)
(setq main_i 0)
(loop while (< main_i 8) do
(setq main_contrib (* (aref datos main_i) (+ main_i 1)))
(if (> main_contrib 50)
(setf main_acum (+ main_acum main_contrib))
(setf main_acum (+ main_acum 1)))

(setf main_i (+ main_i 1)))
(setq main_p 1)
(setq main_q 256)
(loop while (and (< main_p main_q) (< main_p 200)) do
(setf main_p (* main_p 2)))
(setq main_tri 0)
(setq main_fila 0)
(loop while (< main_fila 5) do
(setq main_k 0)
(loop while (<= main_k main_fila) do
(setf main_tri (+ main_tri 1))
(setf main_k (+ main_k 1)))
(setf main_fila (+ main_fila 1)))
(setq main_mid 4)
(setf (aref datos main_mid) (maximo (aref datos (- main_mid 1)) (aref datos (+ main_mid 1)) ))
(setf g_total (+ (+ main_s main_pw) main_acum))
(setf g_cuenta main_cm)
(print "=== Resultados ===")
(princ main_mx)
(princ main_mn)
(princ main_s)
(princ main_pw)
(princ main_cm)
(princ main_expr1)
(princ main_max_v)
(princ main_pond)
(princ main_idx)
(princ main_tri)
(princ main_cond1)
(princ main_cond2)
(princ main_acum)
(princ main_cl))
